# Server Configuration
PORT=8080

# Database Configuration (cPanel MySQL)
# For cPanel shared hosting, typically:
# - DB_HOST: localhost (or mysql.yourdomain.com, or IP address provided by cPanel)
# - DB_PORT: 3306 (default MySQL port)
# - DB_USER: username_cpanel (format: cpanel_username_dbuser)
# - DB_PASSWORD: password from cPanel MySQL Databases
# - DB_NAME: username_database (format: cpanel_username_dbname)
# Example:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=GIP283rWH2SwSGZvZiA3
# DB_NAME=kytw4343_pay
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-cpanel-username_dbuser
DB_PASSWORD=your-db-password
DB_NAME=your-cpanel-username_dbname

# Redis Configuration
# For Docker Compose, use: redis:6379 (service name)
# For local development, use: localhost:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# JWT Secret Key (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Environment
GIN_MODE=release

# LinkQu Configuration
LINKQU_BASE_URL=https://api.linkqu.id
LINKQU_USERNAME=your-linkqu-username
LINKQU_PIN=your-linkqu-pin
LINKQU_CLIENT_ID=your-linkqu-client-id
LINKQU_CLIENT_SECRET=your-linkqu-client-secret
LINKQU_CALLBACK_URL=https://webhook-v2.kytapay.com

# PakaiLink Configuration
PAKAILINK_BASE_URL=https://api.pakailink.id
PAKAILINK_PARTNER_ID=your-pakailink-partner-id
PAKAILINK_CHANNEL_ID=your-pakailink-channel-id
PAKAILINK_CLIENT_KEY=your-pakailink-client-key
PAKAILINK_CLIENT_SECRET=your-pakailink-client-secret
PAKAILINK_ACCOUNT_NO=your-pakailink-account-no
PAKAILINK_CALLBACK_URL=https://webhook-v2.kytapay.com

# Iluma Configuration
ILUMA_API_KEY=iluma_live_uf4HfFeR46gQAutlQh1jEFINVwIq0bX1jrVkpOpm5kTiyiWc8LyFAQk33osL1t

